SESSION_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAILS="owner@example.com"
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:6543/postgres"
DATABASE_SSL="true"
DATABASE_POOL_MAX="10"

APP_PUBLIC_URL="https://your-domain.com"
PASSWORD_RESET_EMAIL_PROVIDER="smtp" # smtp or google_apps_script
PASSWORD_RESET_PUBLIC_URL="https://your-domain.com"
PASSWORD_RESET_TOKEN_TTL_MINUTES="60"
PASSWORD_RESET_EMAIL_TIMEOUT_MS="15000"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_REQUIRE_TLS="true"
SMTP_USER="no-reply@your-domain.com"
SMTP_PASSWORD="YOUR_SMTP_APP_PASSWORD"
SMTP_FROM_EMAIL="no-reply@your-domain.com"
SMTP_FROM_NAME="Khmer Vox TTS"
GOOGLE_APPS_SCRIPT_EMAIL_URL=""
GOOGLE_APPS_SCRIPT_EMAIL_SECRET=""
APP_PHONE_UPLOAD_BASE_URL=""
JOB_WORKER_SECRET="replace-with-a-long-random-worker-secret"
JOB_WORKER_BASE_URL="http://web:3000"
DISABLE_INLINE_JOB_WORKER="true"

# Active checkout provider: KHQRcc ABA Pay.
KHQRCC_PROFILE_ID="YOUR_KHQRCC_PROFILE_ID"
KHQRCC_SECRET_KEY="YOUR_KHQRCC_SECRET_KEY"
KHQRCC_API_BASE_URL="https://khqr.cc"
KHQRCC_ORDER_LIFETIME_MINUTES="5"
KHQRCC_SUCCESS_URL=""
KHQRCC_DISPLAY_NAME="KHQRcc ABA Pay"

# Legacy manual/local payment settings kept for old orders and admin tools only.
KHQR_DISPLAY_NAME="Khmer Vox TTS"
KHQR_ACCOUNT="your-bakong-id@example-bank"
KHQR_BAKONG_ACCOUNT_ID="your-bakong-id@example-bank"
KHQR_CITY="Phnom Penh"
KHQR_CURRENCY="USD"
KHQR_USD_TO_KHR_RATE="4100"
BAKONG_API_BASE_URL="https://api-bakong.nbc.gov.kh"
BAKONG_API_TOKEN="YOUR_BAKONG_API_TOKEN"
PAYMENT_CHECKOUT_MODE="khqrcc_qr"
PAYMENT_AUTO_VERIFY_ENABLED="false"
# New checkout uses KHQRcc regardless of the legacy mode value above.
# local_khqr/static_payway_qr/payway_qr are legacy fallback modes only.
STATIC_PAYWAY_QR_IMAGE_URL="/payway-static-qr.png"
STATIC_PAYWAY_QR_ACCOUNT_LABEL="ABA PayWay static QR"
STATIC_PAYWAY_QR_PAYLOAD=""
PAYWAY_WEBHOOK_SECRET="replace-with-a-long-random-payway-secret"
PAYWAY_QR_ENABLED="false"
PAYWAY_ENV="production"
PAYWAY_MERCHANT_ID="YOUR_PAYWAY_MERCHANT_ID"
PAYWAY_API_KEY="YOUR_PAYWAY_API_KEY"
PAYWAY_QR_API_URL="https://checkout.payway.com.kh/api/payment-gateway/v1/payments/generate-qr"
PAYWAY_CHECK_API_URL="https://checkout.payway.com.kh/api/payment-gateway/v1/payments/check-transaction-2"
PAYWAY_QR_LIFETIME_MINUTES="15"

TELEGRAM_ADMIN_HANDLE="@your_admin"
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"

# Single Upstream Config (legacy)
TTS_UPSTREAM_URL="https://YOUR_MODAL_ENDPOINT/v1/audio/speech"
TTS_UPSTREAM_TOKEN="YOUR_MODAL_BEARER_TOKEN"
TTS_UPSTREAM_MODEL="voxcpm2"
# Public delivery is now WAV (PCM-16, mono, 24 kHz). The upstream Modal endpoint
# returns WAV and the website ships those bytes through without re-encoding.
# Set to "mp3" only when pointed at an older wrapper that cannot serve WAV.
TTS_UPSTREAM_RESPONSE_FORMAT="wav"
# Legacy MP3 header rewrite. Ignored on the WAV delivery path; kept here for
# backward compatibility with deployments that still produce MP3.
TTS_OUTPUT_REWRITE_MP3_HEADER="true"

# Multi-account Pool Load Balancer Config (Optional: overrides single upstream config if set)
# TTS_UPSTREAM_POOL='[{"url":"https://acc1.modal.run/v1/audio/speech","token":"token1","label":"Account 1"},{"url":"https://acc2.modal.run/v1/audio/speech","token":"token2","label":"Account 2"}]'

TTS_RATE_LIMIT_WINDOW_MS="60000"
TTS_RATE_LIMIT_LEASE_MS="900000"
TTS_DASHBOARD_RATE_LIMIT="20"
TTS_DASHBOARD_CONCURRENT_LIMIT="2"
TTS_DASHBOARD_CLONE_RATE_LIMIT="8"
TTS_DASHBOARD_CLONE_CONCURRENT_LIMIT="1"
TTS_API_RATE_LIMIT="60"
TTS_API_CONCURRENT_LIMIT="4"
TTS_API_CLONE_RATE_LIMIT="20"
TTS_API_CLONE_CONCURRENT_LIMIT="2"
API_KEY_DEFAULT_MAX_CONCURRENT_JOBS="2"
API_KEY_DEFAULT_MAX_QUEUED_JOBS="10"
BATCH_WEBHOOK_MAX_ATTEMPTS="3"
BATCH_WEBHOOK_SIGNING_SECRET="replace-with-a-long-random-webhook-signing-secret"
AUTH_SIGNIN_RATE_LIMIT="12"
AUTH_SIGNIN_CONCURRENT_LIMIT="4"
AUTH_SIGNUP_RATE_LIMIT="5"
AUTH_SIGNUP_CONCURRENT_LIMIT="2"
AUTH_PASSWORD_RESET_RATE_LIMIT="5"
AUTH_PASSWORD_RESET_CONCURRENT_LIMIT="2"
