# REQUIRED: Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-with-a-long-random-secret"

# PostgreSQL connection (Supabase, Neon, or self-hosted)
DATABASE_URL="postgresql://postgres:***@YOUR_SUPABASE_HOST:5432/postgres"

# Set to "false" only for local Postgres without SSL. Production should keep SSL enabled.
DATABASE_SSL="true"

# Connection pool size (default: 10)
DATABASE_POOL_MAX="10"
ADMIN_EMAILS="owner@example.com"
APP_PUBLIC_URL="https://your-domain.com"
# Optional: enables Redis caching for dashboard counts. Leave empty to use Postgres directly.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Optional for local testing: use your PC LAN IP so a phone can open proof upload links.
APP_PHONE_UPLOAD_BASE_URL=""

# Active checkout provider: KHQRcc ABA Pay.
KHQRCC_PROFILE_ID="YOUR_KHQRCC_PROFILE_ID"
KHQRCC_SECRET_KEY="YOUR_KHQRCC_SECRET_KEY"
KHQRCC_API_BASE_URL="https://khqr.cc"
KHQRCC_ORDER_LIFETIME_MINUTES="5"
KHQRCC_SUCCESS_URL=""
KHQRCC_DISPLAY_NAME="KHQRcc ABA Pay"

# Legacy manual/local payment settings kept for old orders and admin tools only.
KHQR_DISPLAY_NAME="Khmer Vox TTS"
KHQR_ACCOUNT="your-bakong-id@example-bank"
KHQR_BAKONG_ACCOUNT_ID="your-bakong-id@example-bank"
KHQR_CITY="Phnom Penh"
KHQR_CURRENCY="USD"
KHQR_USD_TO_KHR_RATE="4100"
BAKONG_API_BASE_URL="https://api-bakong.nbc.gov.kh"
BAKONG_API_TOKEN="YOUR_BAKONG_API_TOKEN"
PAYMENT_CHECKOUT_MODE="khqrcc_qr"
PAYMENT_AUTO_VERIFY_ENABLED="false"
# New checkout uses KHQRcc regardless of the legacy mode value above.
# local_khqr/static_payway_qr/payway_qr are legacy fallback modes only.
STATIC_PAYWAY_QR_IMAGE_URL="/payway-static-qr.png"
STATIC_PAYWAY_QR_ACCOUNT_LABEL="ABA PayWay static QR"
STATIC_PAYWAY_QR_PAYLOAD=""
PAYWAY_WEBHOOK_SECRET="YOUR_PAYWAY_WEBHOOK_SECRET"
PAYWAY_QR_ENABLED="false"
PAYWAY_ENV="sandbox"
PAYWAY_MERCHANT_ID="YOUR_PAYWAY_MERCHANT_ID"
PAYWAY_API_KEY="YOUR_PAYWAY_API_KEY"
PAYWAY_QR_API_URL="https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/generate-qr"
PAYWAY_CHECK_API_URL="https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/check-transaction-2"
PAYWAY_QR_LIFETIME_MINUTES="20"
PAYWAY_CUSTOMER_PHONE=""
PAYWAY_RECEIPT_ADDRESS=""
PAYWAY_RECEIPT_PHONE=""
PAYWAY_RECEIPT_EMAIL=""
PAYWAY_COMPANY_LOGO_PATH="/logo.png"
TELEGRAM_ADMIN_HANDLE="@your_admin"
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"
TELEGRAM_PAYMENT_BOT_CHAT_ID="YOUR_TELEGRAM_BOT_CHAT_ID"
TELEGRAM_PAYMENT_GROUP_ID="YOUR_PAYWAY_GROUP_ID"
TELEGRAM_PAYMENT_ALLOWED_SENDERS="PayWay by ABA,PayWay,ABA"
TELEGRAM_PAYMENT_AUTO_APPROVE="false" # Set to "true" to auto-approve all matched payments, or "beta" to only auto-approve for beta email list.
TELEGRAM_PAYMENT_BETA_EMAILS="tester1@example.com,tester2@example.com"
TELEGRAM_WEBHOOK_SECRET="generate-a-long-random-telegram-webhook-secret"
JOB_WORKER_SECRET="generate-a-long-random-worker-secret"
JOB_WORKER_BASE_URL="http://127.0.0.1:3000"
JOB_WORKER_ID="vps-worker-1"
# Single Upstream Config (legacy)
TTS_UPSTREAM_URL="https://YOUR_MODAL_ENDPOINT/v1/audio/speech"
TTS_UPSTREAM_TOKEN="YOUR_MODAL_BEARER_TOKEN"
TTS_UPSTREAM_MODEL="voxcpm2"

# Per-request upstream timeout in ms (default 180000 = 180s). Modal GPU cold
# starts can be slow; too low a value causes long-text chunks to abort and
# temporarily disables endpoints. Range 30000-600000.
TTS_UPSTREAM_TIMEOUT_MS="180000"

# How many times to regenerate a chunk if VoxCPM2 returns near-silent audio
# before failing (default 2 retries = up to 3 attempts). Range 0-5. Prevents one
# unlucky near-silent chunk from failing an entire long-text generation.
TTS_NEAR_SILENCE_RETRIES="2"

# Multi-account Pool Load Balancer Config (Optional: overrides single upstream config if set)
# TTS_UPSTREAM_POOL='[{"url":"https://acc1.modal.run/v1/audio/speech","token":"token1","label":"Account 1"},{"url":"https://acc2.modal.run/v1/audio/speech","token":"token2","label":"Account 2"}]'
TTS_RATE_LIMIT_WINDOW_MS="60000"
TTS_RATE_LIMIT_LEASE_MS="900000"
TTS_DASHBOARD_RATE_LIMIT="20"
TTS_DASHBOARD_CONCURRENT_LIMIT="2"
TTS_DASHBOARD_CLONE_RATE_LIMIT="8"
TTS_DASHBOARD_CLONE_CONCURRENT_LIMIT="1"
TTS_API_RATE_LIMIT="60"
TTS_API_CONCURRENT_LIMIT="4"
TTS_API_CLONE_RATE_LIMIT="20"
TTS_API_CLONE_CONCURRENT_LIMIT="2"
API_KEY_DEFAULT_MAX_CONCURRENT_JOBS="2"
API_KEY_DEFAULT_MAX_QUEUED_JOBS="10"
BATCH_WEBHOOK_MAX_ATTEMPTS="3"
BATCH_WEBHOOK_SIGNING_SECRET="generate-a-long-random-webhook-signing-secret"
BATCH_ITEM_MAX_ATTEMPTS="3"
BATCH_ITEM_RETRY_BASE_MS="30000"
BATCH_ITEM_RETRY_MAX_MS="300000"
BATCH_STUCK_JOB_TIMEOUT_MS="900000"
BATCH_STUCK_JOB_MAX_RECOVERIES="3"
AUTH_SIGNIN_RATE_LIMIT="12"
AUTH_SIGNIN_CONCURRENT_LIMIT="4"
AUTH_SIGNUP_RATE_LIMIT="5"
AUTH_SIGNUP_CONCURRENT_LIMIT="2"
JOB_WORKER_INTERVAL_MS="3000"
DISABLE_INLINE_JOB_WORKER="false"
