# REQUIRED: Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-with-a-long-random-secret"

# Local production-build testing only. Do not enable these on the VPS.
# ALLOW_LOCAL_JSON_STORE="true"
# COOKIE_SECURE="false"
# SESSION_COOKIE_SECURE="false"
# CSRF_COOKIE_SECURE="false"
# DISABLE_HTTPS_REDIRECT="true"

# PostgreSQL connection (Supabase, Neon, or self-hosted)
DATABASE_URL="postgresql://postgres:***@YOUR_SUPABASE_HOST:5432/postgres"

# Set to "false" only for local Postgres without SSL. Production should keep SSL enabled.
DATABASE_SSL="true"

# Connection pool size (default: 10)
DATABASE_POOL_MAX="10"
ADMIN_EMAILS="owner@example.com"
APP_PUBLIC_URL="https://your-domain.com"
# Password recovery email. Keep SMTP_URL/SMTP_PASSWORD in the VPS secret only.
PASSWORD_RESET_EMAIL_PROVIDER="smtp" # smtp or google_apps_script
PASSWORD_RESET_PUBLIC_URL="https://your-domain.com"
PASSWORD_RESET_TOKEN_TTL_MINUTES="60"
PASSWORD_RESET_EMAIL_TIMEOUT_MS="15000"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_REQUIRE_TLS="true"
SMTP_USER="no-reply@your-domain.com"
SMTP_PASSWORD="YOUR_SMTP_APP_PASSWORD"
SMTP_FROM_EMAIL="no-reply@your-domain.com"
SMTP_FROM_NAME="Khmer Vox TTS"
# Optional HTTPS relay fallback when the VPS provider blocks outbound SMTP.
GOOGLE_APPS_SCRIPT_EMAIL_URL=""
GOOGLE_APPS_SCRIPT_EMAIL_SECRET=""
# Optional: enables Redis caching for dashboard counts. Leave empty to use Postgres directly.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Optional for local testing: use your PC LAN IP so a phone can open proof upload links.
APP_PHONE_UPLOAD_BASE_URL=""

# Optional: store generated WAV audio in DigitalOcean Spaces/S3-compatible
# object storage instead of inline JSON/Postgres base64. Leave empty to keep
# legacy inline storage.
SPACES_ENDPOINT="https://sgp1.digitaloceanspaces.com"
SPACES_BUCKET="your-audio-bucket"
SPACES_REGION="sgp1"
SPACES_PUBLIC_BASE_URL="https://your-audio-bucket.sgp1.digitaloceanspaces.com"
SPACES_ACCESS_KEY_ID="YOUR_SPACES_ACCESS_KEY_ID"
SPACES_SECRET_ACCESS_KEY="YOUR_SPACES_SECRET_ACCESS_KEY"

# Active checkout provider: KHQRcc ABA Pay.
KHQRCC_PROFILE_ID="YOUR_KHQRCC_PROFILE_ID"
KHQRCC_SECRET_KEY="YOUR_KHQRCC_SECRET_KEY"
KHQRCC_API_BASE_URL="https://khqr.cc"
KHQRCC_ORDER_LIFETIME_MINUTES="5"
KHQRCC_SUCCESS_URL=""
KHQRCC_DISPLAY_NAME="KHQRcc ABA Pay"

# Legacy manual/local payment settings kept for old orders and admin tools only.
KHQR_DISPLAY_NAME="Khmer Vox TTS"
KHQR_ACCOUNT="your-bakong-id@example-bank"
KHQR_BAKONG_ACCOUNT_ID="your-bakong-id@example-bank"
KHQR_CITY="Phnom Penh"
KHQR_CURRENCY="USD"
KHQR_USD_TO_KHR_RATE="4100"
BAKONG_API_BASE_URL="https://api-bakong.nbc.gov.kh"
BAKONG_API_TOKEN="YOUR_BAKONG_API_TOKEN"
PAYMENT_CHECKOUT_MODE="khqrcc_qr"
PAYMENT_AUTO_VERIFY_ENABLED="false"
# New checkout uses KHQRcc regardless of the legacy mode value above.
# local_khqr/static_payway_qr/payway_qr are legacy fallback modes only.
STATIC_PAYWAY_QR_IMAGE_URL="/payway-static-qr.png"
STATIC_PAYWAY_QR_ACCOUNT_LABEL="ABA PayWay static QR"
STATIC_PAYWAY_QR_PAYLOAD=""
PAYWAY_WEBHOOK_SECRET="YOUR_PAYWAY_WEBHOOK_SECRET"
PAYWAY_QR_ENABLED="false"
PAYWAY_ENV="sandbox"
PAYWAY_MERCHANT_ID="YOUR_PAYWAY_MERCHANT_ID"
PAYWAY_API_KEY="YOUR_PAYWAY_API_KEY"
PAYWAY_QR_API_URL="https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/generate-qr"
PAYWAY_CHECK_API_URL="https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/check-transaction-2"
PAYWAY_QR_LIFETIME_MINUTES="20"
PAYWAY_CUSTOMER_PHONE=""
PAYWAY_RECEIPT_ADDRESS=""
PAYWAY_RECEIPT_PHONE=""
PAYWAY_RECEIPT_EMAIL=""
PAYWAY_COMPANY_LOGO_PATH="/logo.png"
TELEGRAM_ADMIN_HANDLE="@your_admin"
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"
TELEGRAM_PAYMENT_BOT_CHAT_ID="YOUR_TELEGRAM_BOT_CHAT_ID"
TELEGRAM_PAYMENT_GROUP_ID="YOUR_PAYWAY_GROUP_ID"
TELEGRAM_PAYMENT_ALLOWED_SENDERS="PayWay by ABA,PayWay,ABA"
TELEGRAM_PAYMENT_AUTO_APPROVE="false" # Set to "true" to auto-approve all matched payments, or "beta" to only auto-approve for beta email list.
TELEGRAM_PAYMENT_BETA_EMAILS="tester1@example.com,tester2@example.com"
TELEGRAM_WEBHOOK_SECRET="generate-a-long-random-telegram-webhook-secret"
JOB_WORKER_SECRET="generate-a-long-random-worker-secret"
JOB_WORKER_BASE_URL="http://127.0.0.1:3000"
JOB_WORKER_ID="vps-worker-1"
# Single Upstream Config (legacy)
TTS_UPSTREAM_URL="https://YOUR_MODAL_ENDPOINT/v1/audio/speech"
TTS_UPSTREAM_TOKEN="YOUR_MODAL_BEARER_TOKEN"
TTS_UPSTREAM_MODEL="voxcpm2"
# Public delivery is now WAV. The upstream Modal endpoint already returns WAV,
# which is what we ship to callers without re-encoding. This var is kept for
# compatibility with old upstream wrappers; normal production should stay "wav".
TTS_UPSTREAM_RESPONSE_FORMAT="wav"

# Per-request upstream timeout in ms (default 180000 = 180s). Modal GPU cold
# starts can be slow; too low a value causes long-text chunks to abort and
# temporarily disables endpoints. Range 30000-600000.
TTS_UPSTREAM_TIMEOUT_MS="180000"

# How many times to regenerate a chunk if VoxCPM2 returns near-silent OR empty
# (header-only) audio before failing (default 2 retries = up to 3 attempts).
# Range 0-5. The dominant failure is a fast/transient empty upstream response,
# so retrying is cheap and usually succeeds on the next attempt.
TTS_NEAR_SILENCE_RETRIES="2"

# Each near-silence retry raises sampling temperature by this step (capped at
# the max) so the retry explores a different model trajectory instead of
# reproducing the same near-silent output with identical parameters.
TTS_RETRY_TEMPERATURE_STEP="0.15"
TTS_RETRY_TEMPERATURE_MAX="0.9"

# Generated-audio quality controls. These defaults trim leading/trailing
# silence on every upstream chunk, reject mostly-silent chunks, and retry them
# instead of publishing a silent WAV. Set either filter to "off" only for
# diagnostics.
TTS_GENERATED_CHUNK_SILENCE_FILTER="silenceremove=start_periods=1:start_duration=0.10:start_threshold=-45dB:start_silence=0.15:stop_periods=-1:stop_duration=1.25:stop_threshold=-45dB:stop_silence=0.25"
TTS_GENERATED_FINAL_SILENCE_FILTER="silenceremove=start_periods=1:start_duration=0.10:start_threshold=-45dB:start_silence=0.15:stop_periods=-1:stop_duration=1.25:stop_threshold=-45dB:stop_silence=0.25"
TTS_CANONICAL_SAMPLE_RATE="24000"
TTS_AUDIO_LOW_WINDOW_DB="-45"
TTS_AUDIO_ANALYSIS_WINDOW_SECONDS="0.25"
# Quality-gate thresholds. Loosened so natural speech with pauses is not wrongly
# rejected; truly silent/empty audio is still caught by the short-duration and
# very-low-level checks. Lower these to be stricter.
TTS_AUDIO_MAX_LOW_WINDOW_RATIO="0.85"
TTS_AUDIO_MAX_LONG_SILENCE_SECONDS="10"
TTS_AUDIO_MAX_TRAILING_SILENCE_SECONDS="4"
# Reject sustained high zero-crossing audio, which usually indicates hiss,
# buzzing, or a non-speech model failure rather than spoken output.
TTS_AUDIO_HIGH_ZCR_THRESHOLD="0.42"
TTS_AUDIO_MAX_HIGH_ZCR_RATIO="0.18"
TTS_AUDIO_MAX_HIGH_ZCR_SECONDS="1"
# Reject sustained loud, steady, tonal model artifacts where VoxCPM2 gets
# stuck on an unnatural vowel/tone. These sections are not silent, so they need
# a separate detector from the silence and high-ZCR checks above.
TTS_AUDIO_TONAL_GROUP_SECONDS="1"
TTS_AUDIO_TONAL_MIN_DB="-22"
TTS_AUDIO_TONAL_MAX_ENVELOPE_CV="0.18"
TTS_AUDIO_TONAL_MIN_AVG_ZCR="0.07"
TTS_AUDIO_TONAL_MIN_PEAK_ZCR="0.10"
# Stuck-vowel buzz bursts are typically 1-2s each; reject a chunk when one
# burst runs longer than this (real seconds) or when too many windows are
# stuck-tonal, so the chunk is regenerated instead of saved with buzzing.
TTS_AUDIO_MAX_STEADY_TONAL_SECONDS="1.5"
TTS_AUDIO_MAX_STEADY_TONAL_RATIO="0.12"
# Completed, already-stored segments with only a short stuck-tonal warning are
# served with a warning instead of breaking the whole merged download. New
# generation remains stricter through TTS_AUDIO_MAX_STEADY_TONAL_SECONDS.
TTS_AUDIO_DELIVERY_MAX_STEADY_TONAL_SECONDS="4.5"
# Trim excess silence at every segment boundary and add a short, faded pause
# before segments are joined into the final long-form WAV.
# Edge trim now only removes deeper silence (-52 dB) so the natural decay and
# breath of speech is kept at chunk edges. Higher (closer to 0) trims more
# aggressively and can make joined sentences sound clipped.
TTS_AUDIO_EDGE_TRIM_DB="-52"
TTS_AUDIO_EDGE_WINDOW_MS="40"
TTS_CHUNK_START_PADDING_MS="35"
TTS_CHUNK_END_PADDING_MS="110"
TTS_CHUNK_EDGE_FADE_MS="0"
# Smooth long-form joins. Quiet phrase boundaries get a short natural pause;
# audible boundaries are crossfaded instead so mid-sentence splits do not sound
# like a cut.
TTS_CHUNK_CROSSFADE_MS="45"
TTS_CHUNK_JOIN_SILENCE_MS="70"
TTS_CHUNK_JOIN_EDGE_WINDOW_MS="60"
TTS_CHUNK_JOIN_QUIET_DB="-42"
# Short directional fade applied only at the active seam to prevent click/pop.
TTS_CHUNK_JOIN_DECLICK_MS="10"
# Optional prompt_wav carry-over between chunks (off by default — pre-2026-06-24
# parallel ref-clone sounded better in production).
# TTS_CHUNK_CONTINUATION="false"
# TTS_CONTINUATION_PROMPT_SECONDS="6"
# TTS_CONTINUATION_HEAD_FADE_MS="30"
TTS_FINAL_START_PADDING_MS="30"
TTS_FINAL_END_PADDING_MS="100"
TTS_FINAL_EDGE_FADE_MS="8"
# Long-audio volume consistency. Independently generated chunks come back at
# slightly different levels, which makes long audio sound louder in the first
# chunk(s) and quieter later. Leveling aligns each chunk to the median chunk
# loudness using a capped linear gain only (volume, not EQ/compression), so the
# raw VoxCPM2 tone is preserved. Disabled by default because levelWavChunksToCommonLoudness
# already runs before join; double-matching can pump volume at seams.
TTS_CHUNK_LOUDNESS_MATCH="true"
# Pre-join chunk RMS leveling (runs before concat). Keep enabled for long audio.
TTS_CHUNK_LEVEL_MATCH="true"
# Max +/- gain applied to any one chunk while leveling (dB). Higher = more
# aggressive matching for very uneven chunks; lower = gentler.
TTS_CHUNK_LEVEL_MAX_GAIN_DB="6"
# RMS windows quieter than this are treated as pauses and excluded when
# measuring a chunk's spoken loudness (dB).
TTS_CHUNK_LEVEL_FLOOR_DB="-45"
# Final whole-file loudness normalization for delivered audio. Raw VoxCPM2 is
# naturally quiet (~-29 LUFS) and can fade within long passages; this brings the
# merged output to a consistent target with a true-peak limiter (volume only,
# no EQ/tone change). Set TTS_OUTPUT_LOUDNORM=false to deliver raw levels.
TTS_OUTPUT_LOUDNORM="true"
TTS_OUTPUT_LOUDNORM_I="-16"
TTS_OUTPUT_LOUDNORM_TP="-1.5"
# Loudness range (LU). Lower = more even start-to-end but less natural dynamics.
TTS_OUTPUT_LOUDNORM_LRA="11"
# Pause capping. VoxCPM2 often inserts 1.5-2s dead-air gaps at spaces/punctuation
# in long text, which sounds like choppy "cut cut" speech. Any silence longer
# than MAX_PAUSE_SECONDS is shortened to KEEP_PAUSE_SECONDS (silence only, speech
# untouched). Set TTS_OUTPUT_PAUSE_CAP=false to keep the model's raw pauses.
TTS_OUTPUT_PAUSE_CAP="true"
TTS_OUTPUT_MAX_PAUSE_SECONDS="0.7"
TTS_OUTPUT_KEEP_PAUSE_SECONDS="0.4"
TTS_OUTPUT_PAUSE_THRESHOLD_DB="-45"
# Talking-speed (tempo) adjustment for the delivered audio. atempo changes the
# speaking pace WITHOUT changing pitch, so the voice identity is preserved. Use
# this when clones inherit a too-fast reference rhythm (sentences run together
# with almost no breathing pauses). Values < 1.0 slow speech down, > 1.0 speed
# it up. 1.0 is a no-op (no re-encode). Clone output uses TTS_OUTPUT_CLONE_TEMPO
# when set, otherwise falls back to TTS_OUTPUT_TEMPO; standard TTS uses
# TTS_OUTPUT_TEMPO only. Set TTS_OUTPUT_TEMPO_ENABLED=false to disable entirely.
TTS_OUTPUT_TEMPO_ENABLED="true"
TTS_OUTPUT_TEMPO="1.0"
TTS_OUTPUT_CLONE_TEMPO="1.0"
# Legacy MP3 header rewrite. Public delivery is now WAV (no container rewrite
# needed for browser seeking), so this flag is ignored on the WAV path. Kept
# here for compatibility with old deployments that still produce MP3.
TTS_OUTPUT_REWRITE_MP3_HEADER="true"
# VoxCPM2 ref-clone upstream (see modal/modal_voxcpm_api.py). With ref_audio,
# do NOT send `voice` — upstream prepends it to speakable Khmer text.
TTS_CLONE_USE_VOICE_DESCRIPTION="false"
# Reference denoise (ZipEnhancer). Default ON. The preset ref clips and most
# user clones are recorded in real environments; without this, broadband
# noise from the reference leaks into every generated chunk.
TTS_UPSTREAM_DENOISE="true"
# Final-output broadband denoise (FFmpeg afftdn). Default ON, NR=14 dB.
TTS_OUTPUT_DENOISE="true"
TTS_OUTPUT_DENOISE_NR="14"
# 2026-06-26: voice clarity filter. VoxCPM2 output has a resonant build-up
# around 300-1500 Hz ("nasal / closed-nose" sound). De-narrowing widens the
# spectrum and adds a gentle compressor so syllables don't peak unevenly.
# Disable if it ever sounds too thin on a studio-clean reference.
TTS_OUTPUT_DE_NARROW="true"
# 2026-06-26: lowered default 11 -> 7. LRA=11 lets loud passages be 8+ dB louder
# than quiet ones even though overall loudness is on target. LRA=7 matches EBU
# R128 broadcast standard and keeps the whole file at consistent perceived volume.
# Set higher (e.g. 11) for music-style content where you want preserved dynamics.
TTS_OUTPUT_LOUDNORM_LRA="7"
# Production-tuned temperatures. Clone 0.8 matches pre-2026-06-24 quality.
# 2026-06-25 update: 0.7 is the durable prod default for both preset and clone
# — balanced speed/quality, lower buzz than 1.0/0.8, faster than 0.55.
TTS_PRESET_TEMPERATURE="0.7"
TTS_CLONE_TEMPERATURE="0.7"
# CFG (guidance scale). Official VoxCPM2 default is 2.0 (hard-capped in code).
TTS_CLONE_CFG_VALUE="2.0"
TTS_PRESET_CFG_VALUE="2.0"
# Whole-synthesis quality retries when delivered audio has buzz/silence issues.
TTS_FINAL_QUALITY_RETRIES="2"

# Legacy MP3 fidelity controls. Public delivery is now WAV (PCM-16, mono,
# 24 kHz) and is shipped as the upstream WAV with no re-encode, so the bitrate
# below has no effect on the WAV delivery path. It is left here for older
# deployments that still produce MP3.
TTS_PUBLIC_MP3_BITRATE="160k"
# Legacy filter envs may still exist in older deployments, but the raw delivery
# path ignores them for generated audio.
# TTS_PUBLIC_AUDIO_FILTER=""

# Multi-account Pool Load Balancer Config (Optional: overrides single upstream config if set)
# TTS_UPSTREAM_POOL='[{"url":"https://acc1.modal.run/v1/audio/speech","token":"token1","label":"Account 1"},{"url":"https://acc2.modal.run/v1/audio/speech","token":"token2","label":"Account 2"}]'
TTS_RATE_LIMIT_WINDOW_MS="60000"
TTS_RATE_LIMIT_LEASE_MS="900000"
TTS_DASHBOARD_RATE_LIMIT="20"
# Chunks of one long dashboard generation fan out in parallel up to this many.
# Raised 2 -> 4 to roughly halve wall time for multi-chunk audio (the Modal
# account autoscales across containers). Lower it if you hit Modal limits.
TTS_DASHBOARD_CONCURRENT_LIMIT="4"
TTS_DASHBOARD_CLONE_RATE_LIMIT="8"
TTS_DASHBOARD_CLONE_CONCURRENT_LIMIT="2"
TTS_API_RATE_LIMIT="60"
TTS_API_CONCURRENT_LIMIT="4"
TTS_API_CLONE_RATE_LIMIT="20"
TTS_API_CLONE_CONCURRENT_LIMIT="2"
API_KEY_DEFAULT_MAX_CONCURRENT_JOBS="2"
API_KEY_DEFAULT_MAX_QUEUED_JOBS="10"
BATCH_WEBHOOK_MAX_ATTEMPTS="3"
BATCH_WEBHOOK_SIGNING_SECRET="generate-a-long-random-webhook-signing-secret"
BATCH_ITEM_MAX_ATTEMPTS="5"
BATCH_ITEM_RETRY_BASE_MS="10000"
BATCH_ITEM_RETRY_MAX_MS="300000"
# How many batch items (e.g. auto-segmented long-text segments) to synthesize
# concurrently. Defaults to 1 with the local JSON store and 4 with Postgres.
# This is the worker-wide cap; the actual parallelism per generation is
# min(this, the per-mode usage policy concurrent limit). Override only when the
# active store and Modal pool can safely absorb it.
# BATCH_ITEM_CONCURRENCY="4"
# Long-text generation targets about one minute of audio per segment. Leave the
# *_CHUNK_CHARS overrides empty unless a specific upstream account needs a hard
# character cap.
DASHBOARD_GENERATION_CHUNK_TARGET_SECONDS="60"
DASHBOARD_GENERATION_CHUNK_CHARS=""
V2_AUDIO_JOB_CHUNK_TARGET_SECONDS="60"
V2_AUDIO_JOB_CHUNK_CHARS=""
TTS_UPSTREAM_CHUNK_TARGET_SECONDS="60"
TTS_UPSTREAM_CHUNK_CHARS=""
# Legacy near-silence repair knobs are ignored by the raw VoxCPM2 generation path.
TTS_NEAR_SILENCE_FALLBACK_CHARS=""
TTS_NEAR_SILENCE_MIN_FALLBACK_CHARS=""
# Legacy MP3 round-trip validation flag. The public path no longer re-encodes
# to MP3 (delivery is WAV), so this is ignored on the WAV path.
TTS_VALIDATE_PUBLIC_MP3_ROUNDTRIP="false"
BATCH_STUCK_JOB_TIMEOUT_MS="900000"
BATCH_STUCK_JOB_MAX_RECOVERIES="3"
AUTH_SIGNIN_RATE_LIMIT="12"
AUTH_SIGNIN_CONCURRENT_LIMIT="4"
AUTH_SIGNUP_RATE_LIMIT="5"
AUTH_SIGNUP_CONCURRENT_LIMIT="2"
AUTH_PASSWORD_RESET_RATE_LIMIT="5"
AUTH_PASSWORD_RESET_CONCURRENT_LIMIT="2"
JOB_WORKER_INTERVAL_MS="3000"
DISABLE_INLINE_JOB_WORKER="false"
